---
export interface Props {
  title?: string;
  description?: string;
  siteName?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  twitterHandle?: string;
  slug?: string;
}

const DOMAIN = "https://gonfolio.pages.dev/";
const DEFAULT_OG_IMAGE =
  "https://github.com/user-attachments/assets/2ff98bd5-8556-453b-b348-e05c92185adb";
const {
  title = "Flavio Oré | Full-Stack Software Engineer • Operational Systems & Automation",
  description = "Full-Stack Software Engineer specialized in developing operational business systems, ERPs, and workflow automations with React, NestJS, Spring Boot, TypeScript, and AWS.",
  siteName = "Flavio Oré • Full-Stack Software Engineer",
  canonical = DOMAIN,
  ogImage,
  ogType = "website",
  twitterHandle = "@h4lanx",
  slug = undefined,
} = Astro.props as Props;
---

<meta charset="UTF-8" />
<meta http-equiv="X-UA-Compatible" content="IE=edge" />
<meta
  name="viewport"
  content="minimum-scale=1, initial-scale=1, width=device-width, shrink-to-fit=no, viewport-fit=cover"
/>

<meta name="image" content="/Stock_Image_of_Doug_Dimmadome_logo.png" />
<meta name="author" content="Flavio Oré" />
<meta
  name="keywords"
  content="Flavio Oré, Full-Stack Software Engineer, Operational Systems, ERP, Business Automation, NestJS, React, TypeScript, Spring Boot, AWS, Microservices"
/>
<meta name="description" content={description} />
<meta name="generator" content={Astro.generator} />

<meta name="robots" content="index,follow" />
<meta name="googlebot" content="index,follow" />

<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={title} />
<meta property="og:image" content={ogImage ?? DEFAULT_OG_IMAGE} />
<meta property="og:type" content={ogType} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />

<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonical} />
<meta property="twitter:title" content={title} />
<meta property="twitter:creator" content={twitterHandle} />
<meta property="twitter:description" content={description} />
<meta
  property="twitter:image"
  content={slug !== undefined ? ogImage : DEFAULT_OG_IMAGE}
/>
<meta
  property="twitter:image:alt"
  content={slug !== undefined
    ? title + " Social Image"
    : "Flavio Oré Full-Stack Software Engineer Portfolio"}
/>

<link rel="canonical" href={canonical} />
<link rel="icon" type="image/svg+xml" href="/favicon.icon" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="manifest" href="/site.webmanifest" />

<title>{title}</title>
