---
export interface Props {
  class?: string;
  [key: string]: any;
}

const { class: className = "size-5", ...props } = Astro.props as Props;
---

<!--
  Description: Renders an SVG icon representing Enterprise Resource Planning (ERP) and multi-module systems.
  Parameters:
    - class: Optional CSS classes to style width, height, and color.
  Return Value: Astro component rendering an SVG element.
  Exceptions & Errors: None.
-->
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  {...props}
>
  <rect width="18" height="18" x="3" y="3" rx="2"></rect>
  <path d="M3 9h18"></path>
  <path d="M9 21V9"></path>
</svg>
