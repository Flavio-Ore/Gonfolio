---
import ChangeLang from "components/ChangeLang.astro";
import { useTranslations } from "i18n/utils";
import type { Params } from "pages/[...lang].astro";

const { lang } = Astro.params as Params;
const t = useTranslations(lang);

const navigationItems = [
  { anchorIdentifier: "about", label: t("nav.about") },
  { anchorIdentifier: "skills", label: t("nav.skills") },
  { anchorIdentifier: "projects", label: t("nav.projects") },
  { anchorIdentifier: "experience", label: t("nav.experience") },
  { anchorIdentifier: "contact", label: t("nav.contact") },
];
---

<nav
  id="main-nav"
  class="fixed top-3 left-1/2 -translate-x-1/2 z-30 flex items-center justify-between gap-3 sm:gap-6 bg-white/80 dark:bg-zinc-950/80 backdrop-blur-md border border-neutral-200/80 dark:border-zinc-800/80 shadow-sm rounded-full px-3.5 sm:px-5 py-1.5 transition-all duration-300 max-w-xl w-[94%] sm:w-auto"
  aria-label="Main Navigation"
>
  <ul class="flex items-center gap-1 sm:gap-2">
    {
      navigationItems.map(({ anchorIdentifier, label }) => (
        <li>
          <a
            href={`#${anchorIdentifier}`}
            class="nav-anchor-link text-xs sm:text-sm font-medium text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100 px-2.5 py-1 rounded-full hover:bg-neutral-100/70 dark:hover:bg-zinc-800/60 transition-colors"
          >
            {label}
          </a>
        </li>
      ))
    }
  </ul>

  <div class="flex items-center">
    <ChangeLang />
  </div>
</nav>

<script>
  /**
   * Initializes smooth scrolling behavior for internal navigation anchor links.
   *
   * @returns Void.
   * @throws Does not throw exceptions.
   */
  function setupSmoothAnchorScrolling(): void {
    const navigationLinks = document.querySelectorAll<HTMLAnchorElement>(".nav-anchor-link");

    navigationLinks.forEach((linkElement) => {
      linkElement.addEventListener("click", (clickEvent) => {
        const targetAnchorHref = linkElement.getAttribute("href");
        if (targetAnchorHref && targetAnchorHref.startsWith("#")) {
          const targetSection = document.querySelector(targetAnchorHref);
          if (targetSection) {
            clickEvent.preventDefault();
            targetSection.scrollIntoView({
              behavior: "smooth",
              block: "start",
            });
          }
        }
      });
    });
  }

  document.addEventListener("DOMContentLoaded", setupSmoothAnchorScrolling);
  document.addEventListener("astro:page-load", setupSmoothAnchorScrolling);
</script>
