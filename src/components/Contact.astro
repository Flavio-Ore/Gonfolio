---
import GithubIcon from "components/icons/GithubIcon.astro";
import GmailIcon from "components/icons/GmailIcon.astro";
import LinkedInIcon from "components/icons/LinkedInIcon.astro";
import SendIcon from "components/icons/SendIcon.astro";
import ShieldCheckIcon from "components/icons/ShieldCheckIcon.astro";
import { useTranslations } from "i18n/utils";
import type { Params } from "pages/[...lang].astro";

export interface Props {
  // Optional custom props
}

const { lang } = Astro.params as Params;
const t = useTranslations(lang);
---

<section id="contact" class="w-full max-w-3xl mx-auto mt-16 mb-20 scroll-mt-20">
  <div class="mb-8">
    <h3
      class="text-3xl font-bold dark:text-amber-200 text-amber-500 text-center md:text-left"
    >
      {t("contact.title")}
    </h3>
  </div>

  <div class="grid md:grid-cols-2 gap-6 sm:gap-8 items-start">
    <!-- Left Column: Trust Signals & Direct Channels -->
    <div class="space-y-5 flex flex-col">
      <div class="space-y-3">
        <h4
          class="text-xl font-bold text-neutral-900 dark:text-neutral-100 tracking-tight"
        >
          {t("contact.subtitle")}
        </h4>
        <p
          class="text-sm leading-relaxed text-neutral-600 dark:text-neutral-300"
        >
          {t("contact.description")}
        </p>

        <!-- Trust Guarantee Badge -->
        <div
          class="inline-flex items-center gap-2.5 px-3.5 py-2.5 rounded-xl border border-amber-500/25 dark:border-amber-400/20 bg-amber-500/5 dark:bg-amber-400/5 text-amber-900 dark:text-amber-300/90 text-xs font-medium w-full shadow-2xs"
        >
          <ShieldCheckIcon
            class="size-4 shrink-0 text-amber-600 dark:text-amber-400"
          />
          <span class="leading-snug">{t("contact.guarantee")}</span>
        </div>
      </div>

      <!-- Direct Action Channels -->
      <div class="space-y-2.5 pt-1">
        <!-- Interactive Copy Email Button Card -->
        <button
          type="button"
          id="copy-email-button"
          data-email-address="gonzaloorech@gmail.com"
          class="w-full flex items-center justify-between p-3.5 rounded-xl border border-neutral-200/80 dark:border-zinc-800/80 bg-white/60 dark:bg-zinc-950/40 hover:border-amber-500/50 dark:hover:border-amber-500/40 hover:bg-amber-500/5 dark:hover:bg-amber-400/5 transition-all duration-200 cursor-pointer group text-left active:scale-[0.99] shadow-2xs"
        >
          <div class="flex items-center gap-3 min-w-0">
            <div
              class="p-2 rounded-lg bg-amber-500/10 text-amber-700 dark:text-amber-300 group-hover:scale-105 transition-transform shrink-0"
            >
              <GmailIcon class="size-5" />
            </div>
            <div class="min-w-0">
              <p
                class="text-[11px] font-semibold text-neutral-500 dark:text-neutral-400 uppercase tracking-wider"
              >
                Email Direct
              </p>
              <p
                class="text-sm font-medium text-neutral-900 dark:text-neutral-100 group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors truncate"
              >
                gonzaloorech@gmail.com
              </p>
            </div>
          </div>
          <span
            id="copy-email-label"
            class="text-xs font-semibold px-2.5 py-1 rounded-md bg-neutral-100 dark:bg-zinc-800 text-neutral-700 dark:text-neutral-300 group-hover:bg-amber-500/20 group-hover:text-amber-900 dark:group-hover:text-amber-200 transition-colors shrink-0 whitespace-nowrap ml-2"
          >
            {t("contact.copyEmail")}
          </span>
        </button>

        <!-- LinkedIn Card -->
        <a
          href="https://www.linkedin.com/in/flavio-ore"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-between p-3.5 rounded-xl border border-neutral-200/80 dark:border-zinc-800/80 bg-white/60 dark:bg-zinc-950/40 hover:border-blue-500/50 dark:hover:border-blue-500/40 hover:bg-blue-500/5 dark:hover:bg-blue-400/5 transition-all duration-200 group text-left active:scale-[0.99] shadow-2xs"
        >
          <div class="flex items-center gap-3 min-w-0">
            <div
              class="p-2 rounded-lg bg-blue-500/10 text-blue-600 dark:text-blue-400 group-hover:scale-105 transition-transform shrink-0"
            >
              <LinkedInIcon class="size-5" />
            </div>
            <div class="min-w-0">
              <p
                class="text-[11px] font-semibold text-neutral-500 dark:text-neutral-400 uppercase tracking-wider"
              >
                LinkedIn
              </p>
              <p
                class="text-sm font-medium text-neutral-900 dark:text-neutral-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors truncate"
              >
                in/flavio-ore
              </p>
            </div>
          </div>
          <span
            class="text-xs font-medium text-neutral-400 dark:text-neutral-500 group-hover:text-blue-500 group-hover:translate-x-0.5 transition-all shrink-0 ml-2"
            >↗</span
          >
        </a>

        <!-- GitHub Card -->
        <a
          href="https://github.com/Flavio-Ore"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-between p-3.5 rounded-xl border border-neutral-200/80 dark:border-zinc-800/80 bg-white/60 dark:bg-zinc-950/40 hover:border-neutral-400 dark:hover:border-zinc-600 hover:bg-neutral-500/5 transition-all duration-200 group text-left active:scale-[0.99] shadow-2xs"
        >
          <div class="flex items-center gap-3 min-w-0">
            <div
              class="p-2 rounded-lg bg-neutral-200/50 dark:bg-zinc-800 text-neutral-800 dark:text-neutral-200 group-hover:scale-105 transition-transform shrink-0"
            >
              <GithubIcon class="size-5" />
            </div>
            <div class="min-w-0">
              <p
                class="text-[11px] font-semibold text-neutral-500 dark:text-neutral-400 uppercase tracking-wider"
              >
                GitHub Verified
              </p>
              <p
                class="text-sm font-medium text-neutral-900 dark:text-neutral-100 transition-colors truncate"
              >
                @Flavio-Ore
              </p>
            </div>
          </div>
          <span
            class="text-xs font-medium text-neutral-400 dark:text-neutral-500 group-hover:text-neutral-900 dark:group-hover:text-neutral-200 group-hover:translate-x-0.5 transition-all shrink-0 ml-2"
            >↗</span
          >
        </a>
      </div>
    </div>

    <!-- Right Column: Inquiry Form -->
    <div
      class="p-5 sm:p-6 rounded-2xl border border-neutral-200/80 dark:border-zinc-800/80 bg-white/50 dark:bg-zinc-950/40 backdrop-blur-sm shadow-xs"
    >
      <form id="contact-inquiry-form" class="space-y-4">
        <div>
          <label
            for="inquiry-sender-name"
            class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-1.5"
          >
            {t("contact.form.name")}
          </label>
          <input
            type="text"
            id="inquiry-sender-name"
            name="name"
            required
            placeholder={t("contact.form.namePlaceholder")}
            class="w-full px-3.5 py-2.5 rounded-xl text-sm border border-neutral-200/90 dark:border-zinc-800 bg-white/80 dark:bg-zinc-900/70 text-neutral-900 dark:text-neutral-100 placeholder:text-neutral-400/80 focus:outline-none focus:border-amber-500/60 focus:ring-2 focus:ring-amber-500/20 transition-all"
          />
        </div>

        <div>
          <label
            for="inquiry-sender-email"
            class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-1.5"
          >
            Email
          </label>
          <input
            type="email"
            id="inquiry-sender-email"
            name="email"
            required
            placeholder={t("contact.form.emailPlaceholder")}
            class="w-full px-3.5 py-2.5 rounded-xl text-sm border border-neutral-200/90 dark:border-zinc-800 bg-white/80 dark:bg-zinc-900/70 text-neutral-900 dark:text-neutral-100 placeholder:text-neutral-400/80 focus:outline-none focus:border-amber-500/60 focus:ring-2 focus:ring-amber-500/20 transition-all"
          />
        </div>

        <div>
          <label
            for="inquiry-message-content"
            class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-1.5"
          >
            {t("contact.form.message")}
          </label>
          <textarea
            id="inquiry-message-content"
            name="message"
            required
            rows="3"
            placeholder={t("contact.form.messagePlaceholder")}
            class="w-full px-3.5 py-2.5 rounded-xl text-sm border border-neutral-200/90 dark:border-zinc-800 bg-white/80 dark:bg-zinc-900/70 text-neutral-900 dark:text-neutral-100 placeholder:text-neutral-400/80 focus:outline-none focus:border-amber-500/60 focus:ring-2 focus:ring-amber-500/20 transition-all resize-none"
          ></textarea>
        </div>

        <!-- Refined Editorial Amber Glass Submit Button -->
        <button
          type="submit"
          id="inquiry-submit-button"
          class="group w-full py-3 px-5 rounded-xl text-sm font-medium border border-amber-500/40 dark:border-amber-500/30 bg-amber-500/10 dark:bg-amber-400/10 text-amber-900 dark:text-amber-200 hover:bg-amber-500/20 dark:hover:bg-amber-400/20 hover:border-amber-500/60 dark:hover:border-amber-400/50 transition-all duration-200 shadow-xs active:scale-[0.98] cursor-pointer flex items-center justify-center gap-2"
        >
          <span id="inquiry-submit-text">{t("contact.form.submit")}</span>
          <SendIcon
            class="size-4 text-amber-700 dark:text-amber-300 group-hover:translate-x-1 group-hover:-translate-y-0.5 transition-transform duration-200 shrink-0"
          />
        </button>

        <!-- Trust Reassurance Micro-Copy -->
        <p
          class="text-[11px] text-center text-neutral-500 dark:text-neutral-400 mt-2 flex items-center justify-center gap-1.5"
        >
          <span>🔒</span>
          <span>{t("contact.form.privacy")}</span>
        </p>
      </form>

      <div
        id="inquiry-status-feedback"
        class="hidden mt-4 p-3 rounded-xl text-xs text-center font-medium"
      >
      </div>
    </div>
  </div>
</section>

<script>
  /**
   * Copies email address to clipboard and displays instant visual confirmation.
   *
   * @param emailAddress - Target email string to write to clipboard.
   * @param labelElement - Target label element to update text temporarily.
   * @returns Promise resolving to void.
   * @throws Does not throw; falls back safely if clipboard API is unavailable.
   */
  async function executeEmailCopyToClipboard(
    emailAddress: string,
    labelElement: HTMLElement | null,
  ): Promise<void> {
    try {
      await navigator.clipboard.writeText(emailAddress);
      if (labelElement) {
        const previousLabelText = labelElement.textContent;
        labelElement.textContent = "Copied! ✓";
        labelElement.classList.add(
          "text-emerald-600",
          "dark:text-emerald-400",
          "font-bold",
        );

        setTimeout(() => {
          labelElement.textContent = previousLabelText;
          labelElement.classList.remove(
            "text-emerald-600",
            "dark:text-emerald-400",
            "font-bold",
          );
        }, 2200);
      }
    } catch {
      window.location.href = `mailto:${emailAddress}`;
    }
  }

  /**
   * Initializes contact event listeners for clipboard copying and form handling.
   *
   * @returns Void.
   * @throws Does not throw.
   */
  function setupContactInteractiveHandlers(): void {
    const copyButton = document.getElementById("copy-email-button");
    const copyLabel = document.getElementById("copy-email-label");

    copyButton?.addEventListener("click", () => {
      const emailTarget =
        copyButton.getAttribute("data-email-address") ??
        "gonzaloorech@gmail.com";
      void executeEmailCopyToClipboard(emailTarget, copyLabel);
    });

    const inquiryForm = document.getElementById(
      "contact-inquiry-form",
    ) as HTMLFormElement | null;
    const statusFeedback = document.getElementById("inquiry-status-feedback");
    const submitButton = document.getElementById(
      "inquiry-submit-button",
    ) as HTMLButtonElement | null;
    const submitText = document.getElementById("inquiry-submit-text");

    inquiryForm?.addEventListener("submit", async (submitEvent) => {
      submitEvent.preventDefault();
      const initialText = submitText?.textContent ?? "Send Message";
      if (submitButton) {
        submitButton.disabled = true;
      }
      if (submitText) {
        submitText.textContent = "Sending...";
      }

      await new Promise((resolve) => setTimeout(resolve, 800));

      if (statusFeedback) {
        statusFeedback.classList.remove(
          "hidden",
          "bg-red-500/10",
          "text-red-600",
        );
        statusFeedback.classList.add(
          "bg-amber-500/10",
          "text-amber-800",
          "dark:text-amber-300",
          "border",
          "border-amber-500/30",
        );
        statusFeedback.textContent =
          "Inquiry sent successfully! I will reply within 24 hours. 🎉";
        inquiryForm.reset();
      }

      if (submitButton) {
        submitButton.disabled = false;
      }
      if (submitText) {
        submitText.textContent = initialText;
      }
    });
  }

  document.addEventListener(
    "DOMContentLoaded",
    setupContactInteractiveHandlers,
  );
  document.addEventListener("astro:page-load", setupContactInteractiveHandlers);
</script>
