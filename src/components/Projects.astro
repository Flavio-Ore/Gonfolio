---
import { Picture } from "astro:assets";
import AppwriteIcon from "components/icons/AppwriteIcon.astro";
import GithubAltIcon from "components/icons/GithubAltIcon.astro";
import JavaSpringIcon from "components/icons/JavaSpringIcon.astro";
import LinkIcon from "components/icons/LinkIcon.astro";
import ReactIcon from "components/icons/ReactIcon.astro";
import ShadcnIcon from "components/icons/ShadcnIcon.astro";
import TailwindIcon from "components/icons/TailwindIcon.astro";
import TypeScriptIcon from "components/icons/TypeScriptIcon.astro";
import { useTranslations } from "i18n/utils";
import type { Params, Projects } from "pages/[...lang].astro";
import { TECHNOLOGIES } from "values/technologies";
import JavaIcon from "./icons/JavaIcon.astro";

export interface Props {
  projects: Projects;
}

const { lang } = Astro.params as Params;
const { projects } = Astro.props;

if (!projects) {
  throw new Error("No projects data provided");
}

const t = useTranslations(lang);
---

<main id="projects" class="mx-auto w-full max-w-3xl scroll-mt-20 mt-16 mb-16">
  <div class="mb-8">
    <h3
      class="text-3xl font-bold dark:text-amber-200 text-amber-500 text-center md:text-left"
    >
      {t("projects.h3")}
    </h3>
  </div>

  <ul class="flex flex-col gap-y-8">
    {
      projects.map(({ data: project }) => (
        <li
          class="group rounded-2xl border border-neutral-200/80 dark:border-zinc-800/80 bg-white/50 dark:bg-zinc-950/40 backdrop-blur-sm p-6 sm:p-7 shadow-xs hover:shadow-md hover:border-amber-500/50 dark:hover:border-amber-500/40 transition-all duration-300"
        >
          <article class="flex flex-col md:flex-row gap-6 md:gap-8 items-stretch">
            <!-- Left Info Panel -->
            <div class="flex flex-col justify-between basis-1/2 space-y-4">
              <div>
                <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-amber-500/10 text-amber-800 dark:text-amber-300 border border-amber-500/20 mb-2.5">
                  <span>{t("projects.badge.caseStudy")}</span>
                </div>
                <h4 class="text-xl font-bold text-neutral-900 dark:text-neutral-100 group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors">
                  {project.name}
                </h4>
                <ul class="list-none pt-3 space-y-1.5 text-sm text-neutral-600 dark:text-neutral-300">
                  {project.description
                    .split(".")
                    .filter((sentence) => sentence.trim().length > 0)
                    .map((sentence) => (
                      <li class="flex items-start gap-2">
                        <span class="text-emerald-600 dark:text-emerald-400 font-bold shrink-0">✓</span>
                        <span class="leading-relaxed">{sentence.trim()}.</span>
                      </li>
                    ))}
                </ul>
              </div>

              <!-- Action Links -->
              <div class="flex flex-wrap items-center gap-3 pt-2">
                <a
                  href={project.demo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-xs font-semibold bg-amber-500/15 dark:bg-amber-400/10 border border-amber-600/30 dark:border-amber-400/30 text-amber-900 dark:text-amber-200 hover:bg-amber-500/25 dark:hover:bg-amber-400/20 hover:border-amber-500/50 transition-all duration-200 shadow-2xs active:scale-95"
                >
                  <LinkIcon class="size-4" />
                  <span>{t("projects.demo")}</span>
                </a>
                <a
                  href={project.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-xs font-semibold border border-neutral-200 dark:border-zinc-800 bg-white/60 dark:bg-zinc-900/40 text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-zinc-800/80 hover:text-neutral-900 dark:hover:text-neutral-100 transition-all duration-200 shadow-2xs active:scale-95"
                >
                  <GithubAltIcon class="size-4" />
                  <span>{t("projects.source")}</span>
                </a>
              </div>
            </div>

            <!-- Right Media & Tech Stack Panel -->
            <div class="flex flex-col justify-between basis-1/2 gap-4">
              <div class="relative overflow-hidden rounded-xl border border-neutral-200/60 dark:border-zinc-800/60 bg-neutral-900">
                <Picture
                  src={project.cover}
                  format={project.cover.format}
                  width="500"
                  height="320"
                  alt={project.imageAlt}
                  class="w-full h-auto object-cover rounded-xl transition-transform duration-500 group-hover:scale-105"
                />
              </div>

              <!-- Tech Stack Badges -->
              <ul class="flex flex-wrap items-center gap-2 text-xs">
                {project.tech.map((technologyIdentifier) => {
                  let TechIconComponent = null;
                  if (technologyIdentifier === TECHNOLOGIES.Typescript) TechIconComponent = TypeScriptIcon;
                  else if (technologyIdentifier === TECHNOLOGIES.React) TechIconComponent = ReactIcon;
                  else if (technologyIdentifier === TECHNOLOGIES.Appwrite) TechIconComponent = AppwriteIcon;
                  else if (technologyIdentifier === TECHNOLOGIES.TailwindCSS) TechIconComponent = TailwindIcon;
                  else if (technologyIdentifier === TECHNOLOGIES.ShadCN) TechIconComponent = ShadcnIcon;
                  else if (technologyIdentifier === TECHNOLOGIES.JavaSpring) TechIconComponent = JavaSpringIcon;
                  else if (technologyIdentifier === TECHNOLOGIES.Java) TechIconComponent = JavaIcon;

                  return (
                    <li
                      class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md border border-neutral-200/70 dark:border-zinc-800/70 bg-white/60 dark:bg-zinc-900/50 text-neutral-700 dark:text-neutral-300 text-[11px] font-medium"
                      title={technologyIdentifier}
                    >
                      {TechIconComponent && <TechIconComponent class="size-3.5" />}
                      <span>{technologyIdentifier}</span>
                    </li>
                  );
                })}
              </ul>
            </div>
          </article>
        </li>
      ))
    }
  </ul>
</main>
